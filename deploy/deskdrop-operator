SOCKET = '/run/deskdrop-trigger/trigger.sock'
STATE = '/var/lib/deskdrop/trigger'
INSTALLATION = 'mmani-shopping-cart-gcp'
CUTOFF = 1793977200
ACTIONS = ('status', 'trigger', 'recover')


def parse_request(raw):
    if len(raw) > 128:
        raise ValueError('Invalid request')
    def unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError('Duplicate field')
            result[key] = value
        return result
    value = json.loads(raw, object_pairs_hook=unique)
    if not isinstance(value, dict) or set(value) != {'action'} or value['action'] not in ACTIONS:
        raise ValueError('Invalid request')
    return value['action']


def peer_uid(connection):
    return struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))[1]


class Custody:
    def __init__(self, directory=STATE, uid=0):
        self.directory = pathlib.Path(directory)
        self.uid = uid

    def safe(self):
        p = self.directory
        if not p.is_absolute() or str(p.resolve()) != str(p):
            raise ValueError('Unsafe custody')
        for parent in (p, *p.parents):
            st = parent.lstat()
            if not stat.S_ISDIR(st.st_mode) or st.st_uid not in (0, self.uid) or st.st_mode & 0o022:
                raise ValueError('Unsafe custody')
            if parent == p and (st.st_uid != self.uid or stat.S_IMODE(st.st_mode) != 0o700):
                raise ValueError('Unsafe custody')

    def open(self, name, flags):
        if name not in ('lease.json', 'enrollment.json', 'execution.lock', 'broker.lock', 'supervisor.lock', 'ready.json', 'route.json', 'runs.json'):
            raise ValueError('Invalid custody file')
        self.safe()
        fd = os.open(self.directory / name, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != self.uid or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != 0o600 or st.st_size > 16384:
            os.close(fd)
            raise ValueError('Unsafe custody file')
        return fd

    def read(self, name):
        with os.fdopen(self.open(name, os.O_RDONLY)) as stream:
            return json.load(stream)

    @contextlib.contextmanager
    def locked(self, name='execution.lock'):
        fd = self.open(name, os.O_RDWR | os.O_CREAT)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            yield
        finally:
            os.close(fd)

    def save(self, record, filename='lease.json'):
        if filename not in ('lease.json', 'ready.json', 'enrollment.json', 'route.json', 'runs.json'): raise ValueError('Invalid record')
        self.safe()
        try:
            os.close(self.open(filename, os.O_RDONLY))
        except FileNotFoundError:
            pass
        payload = json.dumps(record, allow_nan=False).encode()
        if len(payload) > 16384:
            raise ValueError('Oversized lease')
        name = self.directory / ('.lease-' + uuid.uuid4().hex)
        fd = os.open(name, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(fd, 'wb') as stream:
                stream.write(payload)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(name, self.directory / filename)
            directory = os.open(self.directory, os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        finally:
            name.unlink(missing_ok=True)


def authorize(custody, uid, lookup=pwd.getpwuid):
    record = custody.read('enrollment.json')
    if set(record) != {'installation', 'uid', 'username', 'subject', 'verified'} or record['installation'] != INSTALLATION or type(record['uid']) is not int or record['uid'] != uid or uid == 0 or record['verified'] is not True:
        raise PermissionError('Actor denied')
    account = lookup(uid)
    if account.pw_uid != uid or account.pw_name != record['username'] or not isinstance(record['subject'], str) or not record['subject']:
        raise PermissionError('Actor denied')
    return record['subject']


def lease(custody):
    value = custody.read('lease.json')
    if set(value) != {'schema', 'installation', 'run', 'actor', 'boot', 'started', 'deadline', 'phase', 'recoverRequested'} or value['schema'] != 1 or value['installation'] != INSTALLATION or str(uuid.UUID(value['run'])) != value['run'] or value['phase'] not in ('admitted', 'recovering', 'uncertain', 'complete') or type(value['started']) is not int or value['deadline'] != value['started'] + 360 or type(value['recoverRequested']) is not bool or not isinstance(value['actor'], str) or not value['actor'] or not isinstance(value['boot'], str) or not value['boot']:
        raise ValueError('Lease reconciliation required')
    return value


class Broker:
    def __init__(self, custody, readiness, boot, now=time.time, authenticate=authorize, reserve=lambda: None):
        self.custody, self.readiness, self.boot, self.now = custody, readiness, boot, now
        self.authenticate, self.reserve = authenticate, reserve

    def request(self, raw, uid):
        action = parse_request(raw)
        actor = self.authenticate(self.custody, uid)
        with self.custody.locked():
            try:
                record = lease(self.custody)
            except FileNotFoundError:
                record = None
            if action == 'status':
                try: ready = self.readiness() is True and int(self.now()) < CUTOFF and (not record or record['phase'] == 'complete')
                except Exception: ready = False
                return {'installation': INSTALLATION, 'admission': 'ready' if ready else 'closed', 'phase': record['phase'] if record else 'closed', 'run': record['run'] if record else None}
            if record and record['phase'] != 'complete':
                if action == 'recover':
                    record['recoverRequested'] = True
                    self.custody.save(record)
                return {'status': 'joined' if action == 'recover' else 'busy', 'run': record['run']}
            if action == 'recover':
                return {'status': 'no-active-run'}
            now = int(self.now())
            if now >= CUTOFF or (record and now < record['started']) or self.readiness() is not True:
                raise ValueError('Admission closed')
            self.reserve()
            record = {'schema': 1, 'installation': INSTALLATION, 'run': str(uuid.uuid4()), 'actor': actor, 'boot': self.boot, 'started': now, 'deadline': now + 360, 'phase': 'admitted', 'recoverRequested': False}
            self.custody.save(record)
            return {'status': 'accepted', 'run': record['run']}

    def serve(self, endpoint=SOCKET):
        endpoint = pathlib.Path(endpoint)
        parent = endpoint.parent
        if parent.resolve() != parent:
            raise ValueError('Unsafe socket parent')
        for directory in (parent, *parent.parents):
            st = directory.lstat()
            if not stat.S_ISDIR(st.st_mode) or st.st_uid not in (0, self.custody.uid) or st.st_mode & 0o022:
                raise ValueError('Unsafe socket parent')
        fd = self.custody.open('broker.lock', os.O_RDWR | os.O_CREAT)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            try:
                st = endpoint.lstat()
                if not stat.S_ISSOCK(st.st_mode) or st.st_uid != self.custody.uid:
                    raise ValueError('Unsafe socket')
                endpoint.unlink()
            except FileNotFoundError:
                pass
            with socket.socket(socket.AF_UNIX) as server:
                server.bind(str(endpoint))
                endpoint.chmod(0o666)
                server.listen(16)
                while True:
                    connection, _ = server.accept()
                    self.connection(connection)
        finally:
            os.close(fd)

    def connection(self, connection):
        with connection:
            connection.settimeout(2)
            try:
                uid = peer_uid(connection)
                raw = b''
                while len(raw) <= 128:
                    part = connection.recv(129 - len(raw))
                    if not part:
                        break
                    raw += part
                reply = self.request(raw, uid)
            except BlockingIOError:
                try:
                    action = parse_request(raw)
                    self.authenticate(self.custody, uid)
                    current = lease(self.custody)
                    reply = {'status': 'joined' if action == 'recover' else 'busy', 'phase': current['phase'], 'run': current['run']}
                except Exception:
                    reply = {'status': 'busy'}
            except Exception:
                reply = {'status': 'denied-or-reconciliation-required'}
            try:
                connection.sendall(json.dumps(reply).encode())
            except OSError:
                pass


def main(args):
    if len(args) != 1 or args[0] not in ACTIONS:
        raise ValueError('Usage: deskdrop-operator status|trigger|recover')
    parent = pathlib.Path(SOCKET).parent
    st = parent.lstat()
    endpoint = pathlib.Path(SOCKET).lstat()
    if parent.resolve() != parent or st.st_uid != 0 or not stat.S_ISDIR(st.st_mode) or st.st_mode & 0o022 or endpoint.st_uid != 0 or not stat.S_ISSOCK(endpoint.st_mode):
        raise ValueError('Unsafe broker endpoint')
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(5)
        client.connect(SOCKET)
        if peer_uid(client) != 0:
            raise ValueError('Untrusted broker')
        client.sendall(json.dumps({'action': args[0]}).encode())
        client.shutdown(socket.SHUT_WR)
        data = b''
        while len(data) <= 4096:
            part = client.recv(4097 - len(data))
            if not part:
                break
            data += part
        if len(data) > 4096:
            raise ValueError('Oversized response')
        print(json.dumps(json.loads(data)))



CONTROL = 'node:24.13.0-bookworm-slim@sha256:46feb5752989c05b8606e6323fbbc3db667d14ade1c24f5d0d44d9ca9909d607'
BASE = '/opt/deskdrop/trigger'
MONITORING = '/opt/deskdrop/monitoring'
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'DOCKER_CONFIG': '/run/deskdrop'}
MODULES = {'cloud-trigger.mjs', 'cloud-runtime.mjs', 'cloud-monitors.mjs', 'deskdrop-operator', 'deskdrop-trigger.service', 'deskdrop-trigger-recovery.service'}


def protected_read(filename, mode=0o600, limit=262144):
    p = pathlib.Path(filename)
    for parent in p.parents:
        st = parent.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise ValueError('Unsafe protected path')
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != mode or st.st_size > limit:
            raise ValueError('Unsafe protected file')
        return f.read(limit + 1)


def installed():
    manifest = json.loads(protected_read(BASE + '/manifest.json'))
    runtime = json.loads(protected_read(MONITORING + '/runtime.json'))
    receipt = json.loads(protected_read('/var/lib/deskdrop/monitoring/bundle.json'))
    if set(manifest) != {'source', 'monitoring', 'files', 'host'} or set(manifest['files']) != MODULES or manifest['source'] != runtime['source'] or manifest['monitoring'] != runtime['bundleHash'] or receipt['manifestHash'] != runtime['bundleHash'] or receipt['source'] != runtime['source']:
        raise ValueError('Installed identity mismatch')
    if protected_read('/etc/deskdrop/release').decode().splitlines() != [runtime['app'], runtime['checker'], runtime['source']]:
        raise ValueError('Release changed')
    for name, digest in manifest['files'].items():
        if hashlib.sha256(protected_read(BASE + '/' + name)).hexdigest() != digest:
            raise ValueError('Installed source changed')
    for name in ('cloud-runtime.mjs', 'cloud-monitors.mjs'):
        if protected_read(BASE + '/' + name) != protected_read(MONITORING + '/' + name):
            raise ValueError('Monitoring source changed')
    if set(manifest['host']) != {'bootstrap.sh', 'compose.yaml'}:
        raise ValueError('Invalid host receipt')
    for name, digest in manifest['host'].items():
        if hashlib.sha256(protected_read('/opt/deskdrop/' + name, 0o700 if name == 'bootstrap.sh' else 0o600)).hexdigest() != digest:
            raise ValueError('Host bundle changed')
    for name in ('deskdrop-trigger.service', 'deskdrop-trigger-recovery.service'):
        if protected_read('/etc/systemd/system/' + name, 0o644) != protected_read(BASE + '/' + name):
            raise ValueError('Service changed')
    return runtime


def oslogin_mapping(username, uid, fetch=None):
    if fetch is None:
        def fetch(path):
            connection = http.client.HTTPConnection('169.254.169.254', timeout=3)
            try:
                connection.request('GET', path, headers={'Metadata-Flavor': 'Google'})
                response = connection.getresponse()
                if response.status != 200 or response.getheader('Metadata-Flavor') != 'Google':
                    raise PermissionError('OS Login lookup unavailable')
                raw = response.read(65537)
                if len(raw) > 65536: raise PermissionError('OS Login response oversized')
                return json.loads(raw)
            finally: connection.close()
    result = fetch('/computeMetadata/v1/oslogin/users?username=' + urllib.parse.quote(username, safe=''))
    profiles = result.get('loginProfiles', [])
    if len(profiles) != 1 or profiles[0].get('name') != 'mahesh@coderabbit.ai':
        raise PermissionError('Pilot principal mismatch')
    accounts = profiles[0].get('posixAccounts', [])
    matches = [a for a in accounts if a.get('username') == username and str(a.get('uid')) == str(uid) and a.get('operatingSystemType', 'LINUX') == 'LINUX']
    if len(matches) != 1 or uid <= 0:
        raise PermissionError('OS Login mapping mismatch')
    return profiles[0]['name']


def live_authorize(custody, uid):
    subject = authorize(custody, uid)
    account = pwd.getpwuid(uid)
    if oslogin_mapping(account.pw_name, uid) != subject: raise PermissionError('OS Login mapping changed')
    return subject


class Host:
    def __init__(self, custody, config, boot, command=None):
        self.custody, self.config, self.boot = custody, config, boot
        self.command = command or self.execute

    @staticmethod
    def execute(args, timeout=15):
        result = subprocess.run(args, env=ENV, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=timeout, check=True)
        if len(result.stdout) > 1048576: raise ValueError('Oversized control response')
        return result.stdout.decode().strip()

    def labels(self):
        return {'managed_by': 'deskdrop-gcp-trigger', 'deskdrop.cloud_owner': self.config['owner'], 'deskdrop.source': self.config['source'], 'deskdrop.bundle': self.config['bundleHash']}

    def options(self):
        args = ['--pull', 'never', '--name', 'deskdrop-cloud-trigger', '--network', 'host', '--read-only', '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges', '--memory', '128m', '--cpus', '0.25']
        for k, v in self.labels().items(): args += ['--label', k + '=' + v]
        for mount in [BASE + ':' + BASE + ':ro', MONITORING + ':' + MONITORING + ':ro', STATE + ':' + STATE, '/var/lib/deskdrop/monitoring:/var/lib/deskdrop/monitoring', '/var/run/docker.sock:/var/run/docker.sock', '/run/deskdrop-management:/run/deskdrop-management:ro']:
            args += ['-v', mount]
        return args

    def container(self):
        names = self.command(['/usr/bin/docker', 'container', 'ls', '--all', '--format', '{{.Names}}'], timeout=5).splitlines()
        if 'deskdrop-cloud-trigger' not in names: return None
        rows = json.loads(self.command(['/usr/bin/docker', 'inspect', 'deskdrop-cloud-trigger'], timeout=5))
        if len(rows) != 1: raise ValueError('Ambiguous controller')
        r = rows[0]; h = r.get('HostConfig', {}); c = r.get('Config', {})
        if len(r.get('Id', '')) != 64 or any(x not in '0123456789abcdef' for x in r['Id']) or c.get('Image') != CONTROL or c.get('Labels') != self.labels() or h.get('NetworkMode') != 'host' or h.get('ReadonlyRootfs') is not True or h.get('Privileged') or h.get('CapAdd') or h.get('CapDrop') != ['ALL'] or not any(x in h.get('SecurityOpt', []) for x in ('no-new-privileges', 'no-new-privileges:true')):
            raise ValueError('Unowned controller')
        wanted = {}; options = self.options()
        for i, arg in enumerate(options):
            if arg == '-v':
                parts = options[i+1].split(':'); wanted[parts[1]] = (parts[0], len(parts) == 2)
        mounts = r.get('Mounts', [])
        if len(mounts) != len(wanted) or any(m.get('Type') != 'bind' or wanted.get(m.get('Destination')) != (m.get('Source'), m.get('RW')) for m in mounts):
            raise ValueError('Controller mount mismatch')
        return r

    def fence(self):
        r = self.container()
        if r and r['State']['Running']:
            self.command(['/usr/bin/docker', 'kill', r['Id']], timeout=5)
        r = self.container()
        if r and r['State']['Running']: raise ValueError('Controller still running')
        if r: self.command(['/usr/bin/docker', 'rm', r['Id']], timeout=5)
        if self.container(): raise ValueError('Controller cleanup unknown')

    def invoke(self, mode):
        if mode not in ('inspect', 'trigger', 'recover'): raise ValueError('Invalid control mode')
        if installed() != self.config: raise ValueError('Installed source changed')
        identity_ok = True
        try: self.command(['/opt/deskdrop/bootstrap.sh', 'verify'], timeout=30)
        except Exception:
            identity_ok = False
            if mode != 'recover': raise
        self.fence()
        try:
            try: self.command(['/opt/deskdrop/bootstrap.sh', 'management-refresh'], timeout=45)
            except Exception:
                if mode != 'recover': raise
            result = self.command(['/usr/bin/docker', 'run', *self.options(), CONTROL, 'node', BASE + '/cloud-trigger.mjs', mode], timeout=240 if mode == 'trigger' else 180)
            result = json.loads(result)
            if not identity_ok: result['status'] = 'reconciliation-required'
            return result
        finally:
            try: self.fence()
            finally:
                try: os.unlink('/run/deskdrop-management/management')
                except FileNotFoundError: pass

    def reserve_cycle(self):
        try: count = self.custody.read('runs.json')
        except FileNotFoundError: count = {'reserved': 0}
        if set(count) != {'reserved'} or type(count['reserved']) is not int or not 0 <= count['reserved'] < 3: raise ValueError('Rehearsal limit')
        self.custody.save({'reserved': count['reserved'] + 1}, 'runs.json')

    def ready(self):
        try: count = self.custody.read('runs.json')
        except FileNotFoundError: count = {'reserved': 0}
        if set(count) != {'reserved'} or type(count['reserved']) is not int or not 0 <= count['reserved'] < 3: return False
        r = self.custody.read('ready.json')
        return r == {'boot': self.boot, 'ready': True, 'updated': r.get('updated')} and type(r['updated']) is int and 0 <= time.time() - r['updated'] <= 5

    def mark(self, ready):
        self.custody.save({'boot': self.boot, 'ready': ready, 'updated': int(time.time())}, 'ready.json')

    def cycle(self, allow_trigger=False):
        with self.custody.locked():
            self.mark(False)
            try: record = lease(self.custody)
            except FileNotFoundError: record = None
            if record and record['phase'] != 'complete':
                fresh = allow_trigger and record['phase'] == 'admitted' and record['boot'] == self.boot and not record['recoverRequested'] and record['started'] <= time.time() < min(record['deadline'], CUTOFF)
                record['phase'] = 'recovering'; self.custody.save(record)
                if fresh:
                    try: self.invoke('trigger')
                    except Exception: pass
                # A separate invocation also reconciles a killed/timed-out fault worker.
                try: result = self.invoke('recover')
                except Exception: result = {'status': 'reconciliation-required'}
                record['phase'] = 'complete' if result.get('status') == 'restored' and result.get('run') == record['run'] else 'uncertain'
                self.custody.save(record)
                if record['phase'] != 'complete': return
            result = self.invoke('inspect')
            if result.get('status') == 'ready': self.mark(True)


@contextlib.contextmanager
def management_lock():
    fd = os.open('/var/lib/deskdrop/monitoring/management.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != 0o600:
            raise ValueError('Unsafe management lock')
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield
    finally: os.close(fd)


def service_main(mode):
    if os.getuid() != 0 or mode not in ('broker', 'recovery', 'enroll'):
        raise PermissionError('Root service required')
    config = installed(); custody = Custody(); custody.safe()
    boot = pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()
    host = Host(custody, config, boot)
    if mode == 'enroll':
        # Root stages actual identity/routing evidence; no public protocol can enroll.
        evidence = json.loads(protected_read('/etc/deskdrop/trigger-enrollment.json'))
        if set(evidence) != {'uid', 'username', 'rule', 'recipient'} or type(evidence['uid']) is not int:
            raise ValueError('Invalid enrollment evidence')
        uid = evidence['uid']; account = pwd.getpwuid(uid)
        if account.pw_name != evidence['username']: raise ValueError('NSS mapping mismatch')
        subject = oslogin_mapping(account.pw_name, uid)
        import re
        if not re.fullmatch(r'[A-Za-z0-9-]{1,128}', evidence['rule']) or not re.fullmatch(r'[A-Za-z0-9_-]{1,128}', evidence['recipient']):
            raise ValueError('Invalid route')
        with custody.locked():
            try:
                if lease(custody)['phase'] != 'complete': raise ValueError('Active reservation')
            except FileNotFoundError: pass
            custody.save({'installation': INSTALLATION, 'uid': uid, 'username': account.pw_name, 'subject': subject, 'verified': True}, 'enrollment.json')
            custody.save({'rule': evidence['rule'], 'recipient': evidence['recipient']}, 'route.json')
        return
    if mode == 'broker':
        Broker(custody, host.ready, boot, authenticate=live_authorize, reserve=host.reserve_cycle).serve(); return
    with custody.locked('supervisor.lock'):
        first = True
        stopping = False
        def stop(*args):
            nonlocal stopping
            stopping = True
            raise InterruptedError('Service stopping')
        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        while not stopping:
            try:
                # Same OS lock as stage14 management, excluding concurrent lifecycle writes.
                with management_lock(): host.cycle(allow_trigger=not first)
            except Exception:
                try: host.mark(False)
                except Exception: pass
            first = False
            if not stopping:
                try: time.sleep(1)
                except InterruptedError: pass
        host.mark(False)
        with management_lock():
            host.fence()
            host.cycle(allow_trigger=False)
        host.mark(False)


if __name__ == '__main__':
    try:
        if len(sys.argv) == 2 and sys.argv[1] in ('--broker', '--recovery', '--enroll'):
            service_main(sys.argv[1][2:])
        else: main(sys.argv[1:])
    except Exception:
        print('Operator unavailable or request denied', file=sys.stderr)
        sys.exit(1)
