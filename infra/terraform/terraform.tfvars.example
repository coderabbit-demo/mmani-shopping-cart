# Foundation legitimately has no image identity. Use the same GCS backend/prefix.
project_id   = "se-demos-project"
region       = "us-central1"
zone         = "us-central1-a"
environment  = "demo"
phase        = "foundation"
# For release: phase="release", cloud_release=true and image_digest from the
# verified owned immutable app digest. Never put a placeholder digest in a plan.
